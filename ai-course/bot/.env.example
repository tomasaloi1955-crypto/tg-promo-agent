# Скопируйте в .env (локально) или впишите на Render → Environment.
# Обязательные помечены (!).

# (!) Токен бота от @BotFather
BOT_TOKEN=1234567890:AA...
# (!) PostgreSQL — ОТДЕЛЬНАЯ база (новый проект в Neon), не база sister-bot
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# (!) Секрет вебхука Telegram — латиница и цифры, 20+ символов
WEBHOOK_SECRET=change_me_random_letters_and_digits
# (!) Ключ для /tick — тот же вписать в GitHub-секрет NEURO_TICK_URL (…/tick?key=ЭТОТ_КЛЮЧ)
TICK_KEY=change_me_another_random_string
# Адрес сервиса. На Render НЕ нужен (берётся из RENDER_EXTERNAL_URL)
BASE_URL=
# (!) Ваш Telegram ID (@userinfobot). Несколько — через запятую
ADMIN_IDS=123456789
# Подпись в ответах /reply
AUTHOR_NAME=Freya

# Тексты
CHANNEL_LINK=https://t.me/Halalaifreya
FREE_CHAT_LINK=https://t.me/+xxxxxxxx
COURSE_START=17 ноября
MENTOR_SEATS=10

# Часовой пояс по умолчанию и часы (по времени участника)
DEFAULT_TZ=Asia/Almaty
DAY_HOUR=11
EVENING_HOUR=19
INFO_HOUR=13
NUDGE_HOUR=17
CHECKIN_HOUR=20
PRESENT_HOUR=21
QUIET_HOUR=22
MISSING_HOUR=21
# Ранняя цена — до конца этого дня воронки
EARLY_LAST_DAY=7

# Один закрытый канал на весь курс — заполните только COURSE_CHAT_ID.
# Закрытые каналы курса (id вида -100…; бот — админ с правом «Пригласительные ссылки»).
# Можно один общий COURSE_CHAT_ID на всё — тогда каналы потоков не нужны.
COURSE_CHAT_ID=
COURSE_CHAT_T1=
COURSE_CHAT_T2=
COURSE_CHAT_T3=
COURSE_CHAT_T4=
# Чат наставника (только тариф mentor)
COURSE_CHAT_MENTOR=

# Тарифы: t1–t4 — один поток, full — всё, mentor — с наставником.
# PRICE_* — ранняя цена (как показать), *_LATE — обычная.
PRICE_T1=4 900 ₽
PRICE_T1_LATE=6 900 ₽
PRICE_T2=4 900 ₽
PRICE_T2_LATE=6 900 ₽
PRICE_T3=4 900 ₽
PRICE_T3_LATE=6 900 ₽
PRICE_T4=4 900 ₽
PRICE_T4_LATE=6 900 ₽
PRICE_FULL=12 900 ₽
PRICE_FULL_LATE=17 900 ₽
PRICE_MENTOR=24 900 ₽
PRICE_MENTOR_LATE=34 900 ₽

# Tribute: ссылки на цифровые товары. *_LATE — товар по обычной цене (пусто — та же ссылка)
TRIBUTE_LINK_T1=
TRIBUTE_LINK_T1_LATE=
TRIBUTE_LINK_T2=
TRIBUTE_LINK_T2_LATE=
TRIBUTE_LINK_T3=
TRIBUTE_LINK_T3_LATE=
TRIBUTE_LINK_T4=
TRIBUTE_LINK_T4_LATE=
TRIBUTE_LINK_FULL=
TRIBUTE_LINK_FULL_LATE=
TRIBUTE_LINK_MENTOR=
TRIBUTE_LINK_MENTOR_LATE=
# id товаров Tribute каждого тарифа — ранний и обычный через запятую.
# Не знаете id — оплатите сами: бот пришлёт «незнакомый товар, id …».
TRIBUTE_PRODUCT_IDS_T1=
TRIBUTE_PRODUCT_IDS_T2=
TRIBUTE_PRODUCT_IDS_T3=
TRIBUTE_PRODUCT_IDS_T4=
TRIBUTE_PRODUCT_IDS_FULL=
TRIBUTE_PRODUCT_IDS_MENTOR=
# API-ключ Tribute (проверка подписи вебхука). Тот же, что у sister-bot, если аккаунт общий
TRIBUTE_API_KEY=

# Запасная оплата звёздами Telegram (0 — кнопка скрыта)
STARS_PRICE_T1=0
STARS_PRICE_T2=0
STARS_PRICE_T3=0
STARS_PRICE_T4=0
STARS_PRICE_FULL=0
STARS_PRICE_MENTOR=0

SEND_RATE=25
